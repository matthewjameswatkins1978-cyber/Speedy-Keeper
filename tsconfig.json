{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "strict": true,
    "types": ["node"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "pi-extension/**/*.ts", "trials/**/*.ts"]
}
